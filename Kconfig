config ZMK_NEMU_LINK_LINK_INTERVAL_MS
    int "Heartbeat and full snapshot interval (ms)"
    depends on ZMK_NEMU_LINK
    range 100 10000
    default 1000
    help
      Periodic STATE and HELLO interval. Physical input still sends immediately.
      Configure the same interval on both halves and the dongle, including
      idle-disabled comparison builds. No extra idle ACK polling is added.

config ZMK_NEMU_LINK_LINK_TIMEOUT_INTERVALS
    int "Link expiry in heartbeat intervals"
    depends on ZMK_NEMU_LINK
    range 5 20
    default 5
    help
      Central source release and peripheral application ACK/handshake expiry
      are INTERVAL_MS times this value (5000ms with the defaults). Five periods
      allow for the one-transaction-delayed ACK and initial handshake.

config ZMK_NEMU_LINK_TEST_DROP_RELEASE_ONCE
    bool "Drop the first immediate release snapshot to test periodic recovery"
    depends on ZMK_NEMU_LINK && ZMK_NEMU_LINK_MODE_SWITCH
    help
      Diagnostic only. Drop one release STATE after each ESB activation.
      The next periodic heartbeat still includes the actual physical state.

config ZMK_NEMU_LINK_IDLE
    bool
    depends on ZMK_NEMU_LINK && ZMK_NEMU_LINK_ROLE_PERIPHERAL
    depends on ZMK_NEMU_LINK_MODE_SWITCH || ZMK_NEMU_LINK_FIXED_ESB
    default y
    help
      Peripheral stops the ESB radio and releases HFCLK between completed
      transactions. It wakes for the next scheduled heartbeat and receives
      acknowledgements during normal transactions.

config ZMK_NEMU_LINK_IDLE_GRACE_MS
    int "Quiet time before radio shutdown (ms)"
    depends on ZMK_NEMU_LINK_IDLE
    range 0 70
    default 0
    help
      Zero shuts the radio down at the first completed, quiet transaction.
      Queued TX, hardware retries and unprocessed RX still prevent shutdown.

config ZMK_NEMU_LINK_IDLE_WAKE_TIMEOUT_MS
    int "Bounded HFCLK idle wake timeout (ms)"
    depends on ZMK_NEMU_LINK_IDLE
    range 1 10
    default 5

config ZMK_NEMU_LINK_IDLE_WAKE_MARGIN_MS
    int "Lead time before scheduled ESB transmission (ms)"
    depends on ZMK_NEMU_LINK_IDLE
    range 0 10
    default 0
    help
      Wake the radio this long before a scheduled transmission. The HFCLK
      startup timeout remains separate; a slower wake can send slightly late.
      Zero wakes at the deadline and sends as soon as the clock is ready,
      avoiding an awake wait before periodic transmissions.

config ZMK_NEMU_LINK_IDLE_RETRY_MS
    int "Backoff after an idle wake failure (ms)"
    depends on ZMK_NEMU_LINK_IDLE
    range 10 1000
    default 100
    help
      Keep clock-failure retry backoff independent of the heartbeat interval.

