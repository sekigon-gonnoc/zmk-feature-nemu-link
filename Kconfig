      interval; keep the normal announcement window and receipt tracking.

config ZMK_NEMU_LINK_STUDIO_PROTOCOL
    bool "Studio synchronization protocol (all three images)"
    depends on ZMK_NEMU_LINK_HOP
    default y if ZMK_NEMU_LINK
    help
      Shared named behavior bindings, combos and physical layouts.
      Enabled by default for Nemu-link images. Requires the hop link and
      matching configuration on all peers; disable it when Studio sync is not
      used.

# The RPC UART chosen node is supplied by studio-rpc-usb-uart. Selecting the
# local Studio UI from that transport keeps build matrices free of a duplicate
# CONFIG_ZMK_STUDIO setting without enabling Nemu-link keymap sync.
DT_CHOSEN_NEMU_LINK_STUDIO_RPC_UART := zmk,studio-rpc-uart

config ZMK_NEMU_LINK_STUDIO_RPC_UART
    bool
    default y if ZMK_NEMU_LINK && BOARD_NEMU_LINK_DONGLE && $(dt_chosen_enabled,$(DT_CHOSEN_NEMU_LINK_STUDIO_RPC_UART))
    select ZMK_STUDIO
    help
      Enable local ZMK Studio when the Nemu-link dongle has the Studio RPC UART
      transport. This does not enable synchronization with Nemu-link peers.

config ZMK_NEMU_LINK_STUDIO_ENDPOINT
    bool "ZMK Studio endpoint with editable keymap"
    depends on ZMK_NEMU_LINK && ZMK_NEMU_LINK_STUDIO_PROTOCOL
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    imply ZMK_STUDIO
    imply ZMK_KEYMAP_SETTINGS_STORAGE
    imply ZMK_KEYMAP_LAYER_REORDERING
    help
      Enable the Studio editor and persistent keymap support on this central.
      The shared runtime Studio protocol must also be enabled on all peers.

