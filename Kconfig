config ZMK_NEMU_LINK
    bool "ZMK Nemu-link"
    depends on SOC_COMPATIBLE_NRF52X && HAS_HW_NRF_CCM
    select ESB
    select ESB_DYNAMIC_INTERRUPTS
    select MPSL_FEM_ONLY
    select ENTROPY_GENERATOR if ZMK_NEMU_LINK_SECURITY
    help
      Runtime radio, split transport, secure link and Studio bridge.

config ZMK_NEMU_LINK_RADIO_DIAGNOSTIC
    bool "Periodic radio counters for USB log diagnostics"
    depends on ZMK_NEMU_LINK && LOG
    help
      Log per-source link/authentication phases and error counters, hardware
      FIFO fullness and software ACK accounting every three seconds. Does not
      log secrets or change the reconnection/search policy.

config ZMK_NEMU_LINK_POWER_PROFILE
    bool "Time peripheral radio and crypto operations"
    depends on ZMK_NEMU_LINK && ZMK_NEMU_LINK_IDLE
    help
      Collect clock/init/CCM/TX/work/shutdown durations and hardware TX
      attempts, then print interval statistics from the link service.
      Uses the system cycle clock (about 30.5 us on the nRF RTC timer).
      Disabled unless explicitly enabled; no additional clock or GPIO is requested.

config ZMK_NEMU_LINK_POWER_PROFILE_HIRES
    bool "Use a diagnostic-only 1 MHz TIMER4 for elapsed times"
    depends on ZMK_NEMU_LINK_POWER_PROFILE && SOC_SERIES_NRF52X
    depends on $(dt_nodelabel_has_compat,timer4,$(DT_COMPAT_NORDIC_NRF_TIMER))
    depends on !NRFX_TIMER4 && !ESB_SYS_TIMER4
    help
      Reserve an otherwise unused TIMER4 without interrupts or PPI. The timer
      runs continuously and changes idle power. For USB timing investigation
      only; do not use this firmware to compare battery current.

config ZMK_NEMU_LINK_POWER_TRACE
    bool "Record a bounded per-transaction timing trace in RAM"
    depends on ZMK_NEMU_LINK_POWER_PROFILE
    help
      Record preparation, CCM setup/IRQ/cleanup, transmit, worker, ACK and
      shutdown boundaries. Print up to three completed traces every three
      seconds. Never record payloads, keys or nonces. No printing in IRQs.

config ZMK_NEMU_LINK_CCM_RADIO
    bool "Overlap CCM with PTX RADIO ramp and ACK reception"
    depends on ZMK_NEMU_LINK && ZMK_NEMU_LINK_ROLE_PERIPHERAL && SOC_NRF52840
    default y
    help
        Gates TX START on successful CCM completion and starts mini ACK
        decryption from RADIO's bit counter. Continuous PRX keeps the
        synchronous path. Requires the checked build-directory ESB hooks.

config ZMK_NEMU_LINK_FULL_STATE_INTERVALS
    int "Full metadata snapshot period in heartbeat intervals"
    depends on ZMK_NEMU_LINK
    range 1 60
    default 10

config ZMK_NEMU_LINK_DELIVERY_RETRIES
    int "Extra ordered attempts after an ESB hardware retry batch fails"
    depends on ZMK_NEMU_LINK
    range 0 15
    default 2
    help
      Retry the same ciphertext at the head of the queue. Hardware retries
      remain enabled. Duplicates never replay mouse movement or sensor deltas.

config ZMK_NEMU_LINK_MOTION_BACKPRESSURE
    bool "Buffer relative pointer motion while the transmit queue is full"
    depends on ZMK_NEMU_LINK && ZMK_NEMU_LINK_ROLE_PERIPHERAL
    default n
    help
      Preserve and merge unsent X/Y movement during transient congestion.
      This can increase pointer latency and does not recover packets that
      were accepted by the radio but could not be delivered.

config ZMK_NEMU_LINK_FAST_INPUT_TIMEOUT_MS
    int "Keep the ESB radio awake after high-rate pointer activity (ms)"
    depends on ZMK_NEMU_LINK && ZMK_NEMU_LINK_IDLE && ZMK_NEMU_LINK_ROLE_PERIPHERAL
    range 10 1000
    default 100
    help
      Keep HFCLK and the ESB radio ready while a registered high-rate input
      sensor is active, then return to normal idle behavior after this period
      without sensor activity. 100ms bridges brief pauses in pointer motion.

config ZMK_NEMU_LINK_MODE_SWITCH
    bool "Runtime BLE/ESB split transport switching"
    depends on ZMK_NEMU_LINK && ZMK_BLE && ZMK_NEMU_LINK_ROLE_PERIPHERAL
    select ZMK_NEMU_LINK_MODE_CONTROL
    select BT_CTLR_HCI_LIFECYCLE_LOCK if BT_LL_SW_SPLIT
    select SOC_FLASH_NRF_RADIO_SYNC_RUNTIME if SOC_FLASH_NRF_RADIO_SYNC_TICKER

config ZMK_NEMU_LINK_FIXED_ESB
    bool "Fixed ESB-only peripheral transport"
    depends on ZMK_NEMU_LINK && ZMK_NEMU_LINK_ROLE_PERIPHERAL && !ZMK_BLE
    default y
    help
      Enable Nemu-link as the only split transport on a peripheral keyboard.
      The transport starts when ZMK selects it and stays active until shutdown.
      This is intended for keyboards that send input to an ESB USB receiver.

# The split software controller hides its runtime IRQ lifecycle settings under
# this developer-only menu. Enable them for the shared BLE/ESB radio path.
config BT_CTLR_ADVANCED_FEATURES
    default y if ZMK_NEMU_LINK_MODE_SWITCH && BT_LL_SW_SPLIT
config BT_CTLR_DYNAMIC_INTERRUPTS
    default y if ZMK_NEMU_LINK_MODE_SWITCH && BT_LL_SW_SPLIT

