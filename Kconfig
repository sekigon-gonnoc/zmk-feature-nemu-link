config ZMK_NEMU_LINK_MODE_CHORD
    bool "Hold configured keys to switch Nemu-link transports"
    depends on ZMK_NEMU_LINK_MODE_CONTROL
    depends on ZMK_NEMU_LINK_MODE_SWITCH || BOARD_NEMU_LINK_DONGLE || \
             (!ZMK_SPLIT && ZMK_NEMU_LINK_FIXED_ESB && ZMK_USB)
    help
      Configure source-0-switch-positions and source-1-switch-positions in the
      sekigon,nemu-link node. Split builds switch BLE/ESB as before. Standalone
      fixed-ESB USB builds switch the preferred endpoint between USB and NONE,
      where NONE routes input through ESB. An omitted list disables that
      source's chord.

config ZMK_NEMU_LINK_MODE_CONTROL
    bool "Nemu-link mode behavior and control"
    depends on ZMK_NEMU_LINK && (ZMK_NEMU_LINK_MODE_SWITCH || BOARD_NEMU_LINK_DONGLE || \
                                 (!ZMK_SPLIT && ZMK_NEMU_LINK_FIXED_ESB && ZMK_USB))
    help
      Build the nl_mode behavior and optional mode chord listener. Runtime
      BLE/ESB switching is opt-in through ZMK_NEMU_LINK_MODE_SWITCH and
      selects this automatically. On a fixed-ESB dongle, enable this explicitly
      to use the mode chord or request BLE return from the keymap or a host
      command. Standalone fixed-ESB USB keyboards can use this behavior to
      switch between local USB and ESB-routed input.

