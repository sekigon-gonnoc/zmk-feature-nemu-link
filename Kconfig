config ZMK_NEMU_LINK_DATA_WHITENING
    bool "Enable RADIO data whitening for Nemu-link ESB"
    depends on ZMK_NEMU_LINK && (SOC_NRF52833 || SOC_NRF52840)
    default y
    help
      Enable RADIO whitening and de-whitening for all packets on the link.
      All peers must use the same setting and whitening IV.

config ZMK_NEMU_LINK_DATA_WHITENING_IV
    int "Nemu-link RADIO whitening initial value"
    depends on ZMK_NEMU_LINK && (SOC_NRF52833 || SOC_NRF52840)
    range 0 127
    default 85
    help
      Seven-bit DATAWHITEIV value used by every peer. The default is 0x55.

config ZMK_NEMU_LINK_KEY_PROVISION_USB
    bool "Register Nemu-link keys over standalone USB HID"
    depends on ZMK_NEMU_LINK && !ZMK_USB && USB_DEVICE_STACK && DT_HAS_NORDIC_NRF_USBD_ENABLED
    default y
    select USB_DEVICE_HID
    help
      Provide the Nemu-link key registration HID feature report on USB-capable
      nRF52 hardware without keyboard USB HID (for example split peripherals).
      ZMK_USB devices already include this report in their keyboard interface.
      Disable only when keys are provisioned by another mechanism.

config ZMK_NEMU_LINK_PERIPHERAL_WAIT_USB
    bool
    depends on ZMK_NEMU_LINK && ZMK_NEMU_LINK_ROLE_PERIPHERAL
    depends on USB_DEVICE_STACK
    default y
    help
      Keep the ESB peripheral transport pending until the USB device stack has
      been initialized. For standalone USB HID, usb_enable() signals readiness;
      for ZMK_USB, ESB starts after the ZMK USB initialization hook. USB host
      enumeration is not required, so ESB also works without a USB cable.

