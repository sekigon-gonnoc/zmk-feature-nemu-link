config ZMK_NEMU_LINK_SEARCH_FAST_MS
    int "Fast discovery duration before reducing search duty (ms)"
    depends on ZMK_NEMU_LINK_HOP && ZMK_NEMU_LINK_ROLE_PERIPHERAL
    range 0 600000
    default 5000
    help
      Fast discovery lasts this long after search starts or local input occurs.

config ZMK_NEMU_LINK_SEARCH_INTERVAL_MS
    int "Discovery window interval after fast discovery (ms)"
    depends on ZMK_NEMU_LINK_HOP && ZMK_NEMU_LINK_ROLE_PERIPHERAL
    range 100 60000
    default 10000
    help
      Repeat a 100ms discovery window at this interval. The existing 20ms
      probes in each window let the dongle deliver its delayed ACK payloads.
      Window starts vary by up to 600ms to avoid locking to the dongle patrol.
      Sleep between windows; normal input timing resumes once connected.

